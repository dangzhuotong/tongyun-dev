{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. App commands (list, status, start, stop, logs) are allowed by default.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:default",
    "process:default",
    "process:allow-restart",
    "updater:default"
  ]
}
